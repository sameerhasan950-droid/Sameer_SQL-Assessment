-- 4. RANK employees department-wise based on salary
-- Ranking starts again for every department
SELECT
  employee_id,
  first_name,
  department_id,
  salary,
  RANK() OVER (
    PARTITION BY department_id
    ORDER BY salary DESC
  ) AS dept_salary_rank
FROM hr.employees;


-- 5. DENSE_RANK employees department-wise based on salary
SELECT
  employee_id,
  first_name,
  department_id,
  salary,
  DENSE_RANK() OVER (
    PARTITION BY department_id
    ORDER BY salary DESC
  ) AS dept_dense_rank
FROM hr.employees;


-- 6. ROW_NUMBER department-wise based on salary
SELECT
  employee_id,
  first_name,
  department_id,
  salary,
  ROW_NUMBER() OVER (
    PARTITION BY department_id
    ORDER BY salary DESC
  ) AS dept_row_number
FROM hr.employees;
