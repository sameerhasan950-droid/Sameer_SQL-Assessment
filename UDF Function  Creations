-- =====================================================
-- 1. FUNCTION: Get Employee Salary
-- =====================================================

CREATE OR REPLACE FUNCTION get_salary(
    p_emp_id IN NUMBER
)
RETURN NUMBER
IS
    v_salary NUMBER;
BEGIN
    SELECT salary INTO v_salary
    FROM hr.employees
    WHERE employee_id = p_emp_id;

    RETURN v_salary;
END;
/

-- Function Call
SELECT get_salary(100) AS salary FROM dual;


-- =====================================================
-- 2. FUNCTION: Get Employee First Name
-- =====================================================

CREATE OR REPLACE FUNCTION get_emp_name(
    p_emp_id IN NUMBER
)
RETURN VARCHAR2
IS
    v_name VARCHAR2(100);
BEGIN
    SELECT first_name INTO v_name
    FROM hr.employees
    WHERE employee_id = p_emp_id;

    RETURN v_name;
END;
/

-- Function Call
SELECT get_emp_name(101) AS employee_name FROM dual;


-- =====================================================
-- 3. FUNCTION: Get Employee Department ID
-- =====================================================

CREATE OR REPLACE FUNCTION get_department(
    p_emp_id IN NUMBER
)
RETURN NUMBER
IS
    v_dept NUMBER;
BEGIN
    SELECT department_id INTO v_dept
    FROM hr.employees
    WHERE employee_id = p_emp_id;

    RETURN v_dept;
END;
/

-- Function Call
SELECT get_department(102) AS department_id FROM dual;


-- =====================================================
-- 4. FUNCTION: Calculate Annual Salary
-- =====================================================

CREATE OR REPLACE FUNCTION annual_salary(
    p_emp_id IN NUMBER
)
RETURN NUMBER
IS
    v_salary NUMBER;
BEGIN
    SELECT salary * 12 INTO v_salary
    FROM hr.employees
    WHERE employee_id = p_emp_id;

    RETURN v_salary;
END;
/

-- Function Call
SELECT annual_salary(100) AS annual_salary FROM dual;


-- =====================================================
-- 5. FUNCTION: Calculate Salary Bonus (10%)
-- =====================================================

CREATE OR REPLACE FUNCTION salary_bonus(
    p_emp_id IN NUMBER
)
RETURN NUMBER
IS
    v_bonus NUMBER;
BEGIN
    SELECT salary * 0.10 INTO v_bonus
    FROM hr.employees
    WHERE employee_id = p_emp_id;

    RETURN v_bonus;
END;
/

-- Function Call
SELECT salary_bonus(100) AS bonus FROM dual;


-- =====================================================
-- 6. FUNCTION: Get Employee Job ID
-- =====================================================

CREATE OR REPLACE FUNCTION get_job(
    p_emp_id IN NUMBER
)
RETURN VARCHAR2
IS
    v_job VARCHAR2(50);
BEGIN
    SELECT job_id INTO v_job
    FROM hr.employees
    WHERE employee_id = p_emp_id;

    RETURN v_job;
END;
/

-- Function Call
SELECT get_job(103) AS job_id FROM dual;


-- =====================================================
-- 7. FUNCTION: Get Total Employees in Department
-- =====================================================

CREATE OR REPLACE FUNCTION total_employees(
    p_dept_id IN NUMBER
)
RETURN NUMBER
IS
    v_count NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_count
    FROM hr.employees
    WHERE department_id = p_dept_id;

    RETURN v_count;
END;
/

-- Function Call
SELECT total_employees(50) AS employee_count FROM dual;


-- =====================================================
-- 8. FUNCTION: Get Maximum Salary in Department
-- =====================================================

CREATE OR REPLACE FUNCTION max_dept_salary(
    p_dept_id IN NUMBER
)
RETURN NUMBER
IS
    v_max_salary NUMBER;
BEGIN
    SELECT MAX(salary) INTO v_max_salary
    FROM hr.employees
    WHERE department_id = p_dept_id;

    RETURN v_max_salary;
END;
/

-- Function Call
SELECT max_dept_salary(60) AS max_salary FROM dual;


-- =====================================================
-- 9. FUNCTION: Get Average Department Salary
-- =====================================================

CREATE OR REPLACE FUNCTION avg_dept_salary(
    p_dept_id IN NUMBER
)
RETURN NUMBER
IS
    v_avg_salary NUMBER;
BEGIN
    SELECT AVG(salary) INTO v_avg_salary
    FROM hr.employees
    WHERE department_id = p_dept_id;

    RETURN ROUND(v_avg_salary, 2);
END;
/

-- Function Call
SELECT avg_dept_salary(50) AS average_salary FROM dual;


-- =====================================================
-- 10. FUNCTION: Get Employee Full Name
-- =====================================================

CREATE OR REPLACE FUNCTION get_full_name(
    p_emp_id IN NUMBER
)
RETURN VARCHAR2
IS
    v_full_name VARCHAR2(200);
BEGIN
    SELECT first_name || ' ' || last_name
    INTO v_full_name
    FROM hr.employees
    WHERE employee_id = p_emp_id;

    RETURN v_full_name;
END;
/

-- Function Call
SELECT get_full_name(100) AS full_name FROM dual;


-- =====================================================
-- BONUS: CALL MULTIPLE FUNCTIONS IN ONE SELECT
-- =====================================================

SELECT
    employee_id,
    get_full_name(employee_id) AS employee_name,
    get_salary(employee_id) AS monthly_salary,
    annual_salary(employee_id) AS yearly_salary,
    salary_bonus(employee_id) AS bonus,
    get_department(employee_id) AS department_id,
    get_job(employee_id) AS job_id
FROM hr.employees
WHERE employee_id BETWEEN 100 AND 110;
